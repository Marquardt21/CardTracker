# Hockey Card Tracker — Environment Variables
# Copy this file to .env and fill in your values

# eBay Developer API — for price lookups and listing drafts
# Register free at https://developer.ebay.com
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_RU_NAME=
EBAY_SHIP_PRICE=4.00
EBAY_SHIP_SERVICE=EbayStandardEnvelope  # EbayStandardEnvelope (cards ≤$20, ~$1.32) or USPSGroundAdvantage (any value, ~$5.17)
EBAY_ZIP=                        # your zip code — required to create the eBay merchant location
EBAY_PLACEHOLDER_IMAGE_URL=      # public URL of placeholder image (e.g. raw GitHub or Imgur link)

# Anthropic API — for "Scan Card with AI" feature (future phase)
# Register at https://console.anthropic.com
ANTHROPIC_API_KEY=
